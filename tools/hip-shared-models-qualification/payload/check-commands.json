    "argv": [
      "python3",
      "-B",
      "<unit>/payload/runner/admin.py",
      "--payload",
      "<unit>/payload",
      "--archive",
      "<unit>/source-payload.tar",
      "--remote-base",
      "<REMOTE_BASE>",
      "--output",
      "<unit>/admin-1"
    ],
    "effects": "mkdir + 3 bounded scp + one native-gpu hydration; no model/GPU/cargo"
  },
